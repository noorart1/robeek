generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  isActive   Boolean      @default(false)
  Class      Class[]
  Enrollment Enrollment[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime @db.Date
  status    String
  notes     String?  @db.Text
  Student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  grade          String
  shift          String?
  capacity       Int?
  academicYearId Int
  teacherName    String?
  teacherUserId  Int?
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  Enrollment     Enrollment[]
  Teacher        User?        @relation(fields: [teacherUserId], references: [id])

  @@index([academicYearId])
  @@index([teacherUserId])
}

model Enrollment {
  id             Int          @id @default(autoincrement())
  studentId      Int
  classId        Int
  academicYearId Int
  enrollmentDate DateTime     @default(now())
  status         String       @default("ACTIVE")
  tuitionFee     Decimal      @default(0.00) @db.Decimal(15, 2)
  attendanceType String?
  paymentPlan    String?
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  Class          Class        @relation(fields: [classId], references: [id])
  Student        Student      @relation(fields: [studentId], references: [id])
  Payment        Payment[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId], map: "Enrollment_academicYearId_fkey")
  @@index([classId])
}

model LoginAttempt {
  id          Int       @id @default(autoincrement())
  ipHash      String    @unique @db.Char(64)
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime
}

model Parent {
  id            Int             @id @default(autoincrement())
  firstName     String?
  lastName      String?
  phone         String?
  phone2        String?
  address       String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  StudentParent StudentParent[]
}

model Payment {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  amount       Decimal    @db.Decimal(15, 2)
  paymentDate  DateTime   @default(now())
  paymentType  String?
  paymentMethod String?   @db.VarChar(20)
  receiptNo    String?    @unique
  description  String?    @db.Text
  createdAt    DateTime   @default(now())
  voidedAt     DateTime?
  voidReason   String?
  Enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([enrollmentId])
}

model Sequence {
  name  String @id @db.VarChar(50)
  value Int    @default(0)
}

model Session {
  id        String   @id
  userId    Int
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Student {
  id              Int             @id @default(autoincrement())
  studentCode     String          @unique
  firstName       String
  lastName        String?
  fatherName      String?
  grandfatherName String?
  birthDate       DateTime?       @db.Date
  birthYear       Int?
  gender          String?
  nationalId      String?         @unique
  phone           String?
  address         String?         @db.Text
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  emergencyPhone  String?
  notes           String?         @db.Text
  photo           String?         @db.Text
  transportLineId Int?
  transportOrder  Int?
  reviewNote      String?         @db.Text
  Attendance      Attendance[]
  Enrollment      Enrollment[]
  StudentParent   StudentParent[]
  TransportLine   TransportLine?  @relation(fields: [transportLineId], references: [id])

  @@index([transportLineId])
}

model StudentParent {
  studentId Int
  parentId  Int
  relation  String
  Parent    Parent  @relation(fields: [parentId], references: [id])
  Student   Student @relation(fields: [studentId], references: [id])

  @@id([studentId, parentId])
  @@index([parentId], map: "StudentParent_parentId_fkey")
}

model TransportLine {
  id          Int       @id @default(autoincrement())
  name        String
  driverPhone String?
  shift       String    @default("MORNING")
  Student     Student[]
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  fullName     String
  role         User_role @default(REGISTRAR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Session      Session[]
  Class        Class[]
}

enum User_role {
  ADMIN
  DEPUTY
  REGISTRAR
  TEACHER
}

// الكادر: staff of the centre. Not sign-in accounts (those are User).
model Staff {
  id         Int       @id @default(autoincrement())
  name       String
  birthDate  DateTime? @db.Date
  address    String?   @db.VarChar(500)
  phone      String?   @db.VarChar(30)
  education  String?
  shift      String?   @db.VarChar(20)
  job        String?
  baseSalary Decimal?  @db.Decimal(15, 2)
  bonus      Decimal?  @db.Decimal(15, 2)
  startDate  DateTime? @db.Date
  contract   String?
  notes      String?   @db.Text
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  Salary     Salary[]
}

// One salary per staff member per calendar month ("2026-09").
model Salary {
  id            Int       @id @default(autoincrement())
  staffId       Int
  month         String    @db.Char(7)
  baseSalary    Decimal   @db.Decimal(15, 2)
  bonus         Decimal   @default(0) @db.Decimal(15, 2)
  deduction     Decimal   @default(0) @db.Decimal(15, 2)
  paidOn        DateTime? @db.Date
  paymentMethod String?   @db.VarChar(20)
  notes         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Staff         Staff     @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
}

// المصاريف: GENERAL (المصاريف العامة) or ASSET (الأصول والتطوير).
model Expense {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  category      String   @default("GENERAL") @db.VarChar(20)
  item          String
  amount        Decimal  @db.Decimal(15, 2)
  paymentMethod String?  @db.VarChar(20)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([date])
}
